{
  "expo": {
    "name": "Beredskap",
    "slug": "beredskap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "beredskap",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "no.beredskap.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Posisjonen brukes kun på telefonen for å finne nærmeste tilfluktsrom."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2481B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "no.beredskap.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2EFE7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0C0D0B"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Posisjonen brukes kun på telefonen for å finne nærmeste tilfluktsrom."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F2481B"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "sheltersUrl": ""
    }
  }
}
